# Copy to .env and edit. Never commit the real .env file.
PORT=3000
# Public address employees use to open the app (used in emailed links)
APP_URL=http://localhost:3000

COMPANY_NAME=Dixel Technologies
COMPANY_DOMAIN=dixeltechnologies.com

# SQLite database file
DB_PATH=./data/chat.db

# Session lifetime in hours
SESSION_HOURS=12
# Messages older than this are deleted automatically (0 = keep forever)
RETENTION_DAYS=365

# true  = employees on the admin invite list are activated right after verifying their email
# false = every new employee must be approved by an administrator
AUTO_APPROVE_INVITED=true

# Set both to true when serving over HTTPS (recommended in production).
# TRUST_PROXY=true when running behind nginx/IIS/a load balancer.
COOKIE_SECURE=false
TRUST_PROXY=false
NODE_ENV=development

# Email (needed for password reset emails).
# Leave SMTP_HOST empty in development: links are printed in the server console and data/dev-mail.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dixel Chat <no-reply@dixeltechnologies.com>"
